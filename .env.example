# Supabase — Project Settings → API Keys
# The new key system (sb_publishable_* / sb_secret_*) replaces the legacy anon / service_role JWTs.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Server-only — never expose to the browser
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe (week 2+) — test mode only
STRIPE_SECRET_KEY=sk_test_...
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# AI layer (week 3+)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Observability (week 6+)
PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
